# Local: copie para .env. Vercel: cadastre API_URL em Environment Variables.
# Sem caminho, /api e acrescentado. Caminhos explicitos sao preservados.
# Na Vercel utilize a URL publica HTTPS do backend.
API_URL=https://liara.picos.ifpi.edu.br/ccomp-api/api

# OAuth Client ID publico do Google (mesmo valor usado no backend)
GOOGLE_CLIENT_ID=
