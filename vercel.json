{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/ccomp-frontend/browser",
  "functions": {
    "api/render.mjs": {
      "includeFiles": "dist/ccomp-frontend/**"
    }
  },
  "routes": [
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/api/render" }
  ]
}
